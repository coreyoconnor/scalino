-/** A from-scratch, hand-rolled implementation of the Language Server
- *  Protocol for Dotty -- no lsp4j, no Gson/Jackson, no runtime reflection.
- *
- *  You should not have to directly use this class, instead see
- *  `dotty.tools.languageserver.Main`, which owns the actual JSON-RPC
- *  transport (framing, dispatch, request/response encoding via `Lsp`'s
- *  hand-written jsoniter-scala codecs) and calls into the plain methods
- *  below synchronously.
- *
- *  For more information see:
- *  - The LSP is defined at https://github.com/Microsoft/language-server-protocol
- *
- *  Previously based on lsp4j (https://github.com/eclipse/lsp4j); replaced
- *  after discovering a GraalVM native-image-specific pathology where Gson's
- *  reflective `TypeAdapter` construction for a real editor's full-sized
- *  `initialize` capabilities payload silently never completed under
- *  native-image (worked fine under a real JVM with the identical bytes/
- *  classes) -- see docs/findings.md "JVM-free language server (LSP)".
- *
- *  @param publishDiagnostics Callback invoked to send a
- *    `textDocument/publishDiagnostics` notification to the client.
- */
-class DottyLanguageServer(publishDiagnostics: (String, List[Lsp.Diagnostic]) => Unit) { thisServer =>
-  import ast.tpd._
-  import DottyLanguageServer._
-  import InteractiveDriver._
-
-  private var rootUri: String = uninitialized
-
-  private var myDrivers: mutable.Map[ProjectConfig, InteractiveDriver] = uninitialized
-
-  private var myDependentProjects: mutable.Map[ProjectConfig, mutable.Set[ProjectConfig]] = uninitialized
