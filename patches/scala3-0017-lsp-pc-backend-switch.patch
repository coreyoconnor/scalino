-      // Unlike Metals (which bootstraps this file itself via BSP before the
-      // language server ever starts), scalino's workflow requires a separate,
-      // explicit `scalino setup-ide` run first -- a real user is much more
-      // likely to open a project before running that than to hit a missing/
-      // corrupt config under the original Metals-oriented flow this code was
-      // written for. A clear, actionable message here (instead of a bare
-      // `NoSuchFileException` whose stack trace only reaches a log file the
-      // user never looks at) is worth the special case.
-      if !configFile.exists then
-        throw FileNotFoundException(
-          s"$IDE_CONFIG_FILE not found at $rootUri -- run `scalino setup-ide <sources...>` in the project root first")
-      val configs: List[ProjectConfig] = readFromArray(Files.readAllBytes(configFile.toPath))(using projectConfigListCodec)
-
-      val defaultFlags = List("-color:never" /*, "-Yplain-printer","-Yprint-pos"*/)
-
-      myDrivers = new mutable.HashMap
-      for (config <- configs) {
-        implicit class updateDeco(ss: List[String]) {
-          def update(pathKind: String, pathInfo: String) = {
-            val idx = ss.indexOf(pathKind)
-            val ss1 = if idx >= 0 then ss.take(idx) ++ ss.drop(idx + 2) else ss
-            ss1 ++ List(pathKind, pathInfo)
-          }
-        }
-        val settings =
-          defaultFlags ++
-          config.compilerArguments
-            .update("-d", new File(config.classDirectory).getAbsolutePath)
-            .update("-classpath", (config.classDirectory +: config.dependencyClasspath).mkString(File.pathSeparator))
-            .update("-sourcepath", config.sourceDirectories.mkString(File.pathSeparator))
-        // One misconfigured project (e.g. a `dependencyClasspath` missing a
-        // real Scala library, which makes `InteractiveDriver`'s own
-        // `Definitions.init` throw `MissingCoreLibraryException`) must not
-        // take every *other* project in the same `.scalino-build/scalino-lsp.json` down
