-  /** Runs `fun` while holding this server's lock, converting a critical
-   *  memory condition into a background driver restart first (matching
-   *  the previous lsp4j-based `computeAsync`'s behavior, minus its
-   *  cancellation support -- nothing in this codebase ever checked a
-   *  cancel token, so dropping it changes nothing observable). */
-  def computeSync[R](fun: => R): R = {
-    checkMemory()
-    try
-      thisServer.synchronized { fun }
-    catch {
-      case NonFatal(ex) =>
-        ex.printStackTrace
-        throw ex
-    }
-  }
