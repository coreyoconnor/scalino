-import java.lang.management.ManagementFactory
-
-object Memory {
-
-  /** Memory is judged to be critical if after a GC the amount of used memory
-   *  divided by total available memory exceeds this threshold.
-   */
-  val UsedThreshold = 0.9
-
-  /** If total available memory is unknown, memory is judged to be critical if
-   *  after a GC free memory divided by used memory is under this threshold.
-   */
-  val FreeThreshold = 0.1
-
-  /** Turn this flag on to stress test restart capability in compiler.
-   *  It will restart the presentation compiler after every 10 editing actions
-   */
-  private final val stressTest = false
-  private var stressTestCounter = 0
-
-  // `Runtime#{maxMemory,totalMemory,freeMemory}` are real JDK-only methods --
-  // absent from Scala Native's own same-named `java.lang.Runtime` stub, which
-  // only declares `gc()`. `java.lang.management.ManagementFactory`/
-  // `MemoryMXBean`/`MemoryUsage`, by contrast, are standard JDK API that Scala
-  // Native's javalib also implements for real (backed by `GC.get{Used,Max}HeapSize`),
-  // so using them here is a single, unconditional, correct-on-every-backend fix
-  // rather than a platform-specific workaround.
-  private def heapUsage() = ManagementFactory.getMemoryMXBean().getHeapMemoryUsage()
-
-  /** Is memory critically low? */
-  def isCritical(): Boolean = {
-    if (stressTest) {
-      stressTestCounter += 1
-      if (stressTestCounter % 10 == 0) return true
-    }
-    val bean = ManagementFactory.getMemoryMXBean()
-    def usage = bean.getHeapMemoryUsage()
-    def used = usage.getUsed
-    def maximal = usage.getMax
-    def free = usage.getCommitted - used
-    def usedIsCloseToMax =
-      if maximal < 0 then free.toDouble / used < FreeThreshold
-      else used.toDouble / maximal > UsedThreshold
-    usedIsCloseToMax && { bean.gc(); usedIsCloseToMax }
-  }
-
-  def stats(): String = {
-    val M = 2 << 20
-    val usage = heapUsage()
-    def total = usage.getCommitted / M
-    def maximal = usage.getMax / M
-    def free = (usage.getCommitted - usage.getUsed) / M
-    s"total used memory: $total MB, free: $free MB, maximal available = $maximal MB"
-  }
-}
