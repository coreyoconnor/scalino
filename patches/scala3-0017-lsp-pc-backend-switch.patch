-  def initialize(rootUri: String): InitializeResult = computeSync {
-    this.rootUri = rootUri
-    assert(rootUri != null)
-
-    val capabilities = ServerCapabilities(
-      textDocumentSync = 1, // Full
-      documentHighlightProvider = true,
-      documentSymbolProvider = true,
-      definitionProvider = true,
-      renameProvider = true,
-      hoverProvider = true,
-      workspaceSymbolProvider = true,
-      referencesProvider = true,
-      implementationProvider = true,
-      completionProvider = CompletionOptions(triggerCharacters = List(".")),
-      signatureHelpProvider = SignatureHelpOptions(triggerCharacters = List("(")))
-
-    // Do most of the initialization asynchronously so that we can return early
-    // from this method and thus let the client know our capabilities.
-    //
-    // On failure (most commonly: no scalino-lsp.json yet, see `drivers`'s own
-    // check), just log it and return -- NOT `sys.exit`, unlike the original
-    // lsp4j-based code this was ported from (faithfully preserved through the
-    // rewrite, but wrong for scalino specifically: under GraalVM native-image,
-    // an uncaught exception on ANY thread terminates the whole process, so
-    // this used to kill the entire editor connection on a missing config
-    // instead of just failing this one request). Leaving `myDrivers` unset
-    // means the SAME exception surfaces again, cleanly, the next time
-    // anything (didOpen, hover, ...) actually needs `drivers` -- and that
-    // path already goes through `Main.scala`'s own per-request try/catch,
-    // which reports it as a normal LSP error response instead of a crash.
-    val warmup = new Thread(() => {
-      try { drivers; () }
-      catch {
-        case NonFatal(ex) =>
-          ex.printStackTrace
-      }
-    })
-    warmup.setDaemon(true)
-    warmup.start()
-
-    InitializeResult(capabilities)
-  }
