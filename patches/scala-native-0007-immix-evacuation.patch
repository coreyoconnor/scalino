@@ -6,5 +6,6 @@
 
 void Marker_MarkRoots(Heap *heap, Stack *stack);
 void Marker_Mark(Heap *heap, Stack *stack);
+void Marker_Evacuate(Heap *heap, Stack *stack);
 
 #endif // IMMIX_MARKER_H
--- a/nativelib/src/main/resources/scala-native/gc/immix/Heap.c
+++ b/nativelib/src/main/resources/scala-native/gc/immix/Heap.c
@@ -178,6 +178,15 @@
         nullify_start_ns = Time_current_nanos();
     }
     WeakReferences_Nullify();
+    // Real evacuation (moves objects) -- strictly opt-in via
+    // $SCALANATIVE_EVAC_ENABLE, no-op otherwise. See Marker.c's "Stage 2"
+    // section for the full design/risk notes. Runs after weak-reference
+    // nullification (so weak-ref fields are already resolved to null or a
+    // real referent, just another field to fix up) and before the normal
+    // sweep (so evacuated blocks -- unmarked by Marker_Evacuate -- get
+    // reclaimed by the existing Block_Recycle path below, no new free-list
+    // code needed).
+    Marker_Evacuate(heap, stack);
     if (stats != NULL) {
         sweep_start_ns = Time_current_nanos();
     }
