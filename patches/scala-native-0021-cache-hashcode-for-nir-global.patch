 package scala.scalanative
 package nir
 
+import scala.annotation.nowarn
+import scala.util.hashing.MurmurHash3
+
 /** The identifier of a type or method (aka a symbol). */
 sealed abstract class Global {
+  self: Product =>
+  // Caches structural hashCode (MurmurHash3.productHash) the same way
+  // nir.Val/Type/Inst do -- Global.Member/Top instances are the map/set keys
+  // for most of linker/interflow's reachability & dedup tables, and the
+  // default case-class hashCode recomputes this every lookup.
+  override lazy val hashCode = MurmurHash3.productHash(self): @nowarn
 
   /** Returns the owner of `this`. */
   def top: Global.Top
