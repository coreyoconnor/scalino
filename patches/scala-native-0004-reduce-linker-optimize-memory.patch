diff --git a/tools/src/main/scala/scala/scalanative/interflow/Interflow.scala b/tools/src/main/scala/scala/scalanative/interflow/Interflow.scala
index 7cb77f2..3fd6da8 100644
--- a/tools/src/main/scala/scala/scalanative/interflow/Interflow.scala
+++ b/tools/src/main/scala/scala/scalanative/interflow/Interflow.scala
@@ -181,9 +181,17 @@ private[scalanative] class Interflow(val config: build.Config)(implicit
     blockFreshTl.set(blockFreshTl.get.tail)
 
   def result(): Seq[nir.Defn] = {
-    val optimized = originals.clone()
-    optimized ++= done
-    optimized.values.toSeq
+    // Was `originals.clone()` then merging `done` into the clone: this
+    // Interflow instance (and therefore `originals`) is discarded the
+    // instant this method returns (see `Interflow.optimize` below --
+    // `interflow` is never referenced again after `.result()`), so the
+    // clone was a second full-corpus-sized copy of `originals` with no
+    // downstream reader. Mutating in place removes that copy -- traced,
+    // via real profiling on dotc's own NIR (~77K reachable methods), to
+    // the exact site of an `Out of heap space` crash under scala-native's
+    // own GC linking something at that scale.
+    originals ++= done
+    originals.values.toSeq
   }
 
   protected def mode: build.Mode = config.compilerConfig.mode
