 extern word_t *__modules;
 extern int __modules_size;
 
+// Shared by the stage-1 measurement code below and the real Stage 2
+// evacuation phase further down: the forwarding address a moved object
+// leaves behind is written right where the object's own fields start --
+// NOT a hardcoded header size. `Object` conditionally includes a
+// `lockWord` between `rtti` and `fields` under USES_LOCKWORD (real when
+// multithreading is enabled for a given linked binary -- a per-binary
+// compile-time choice, not something this GC code can assume either way).
+// Getting this offset wrong would silently read/write the wrong bytes on
+// any build where USES_LOCKWORD is active -- exactly the kind of bug that
+// produces confusing, seemingly-unrelated corruption far from the real
+// cause. offsetof() always matches the real, currently-compiled layout.
+#define EVAC_FORWARD_OFFSET offsetof(Object, fields)
+
+// An object must have at least one word of space at EVAC_FORWARD_OFFSET to
+// safely hold a forwarding address without writing past its own allocation
+// (matters specifically for a zero-field object under USES_LOCKWORD, where
+// the header alone already fills a full 16-byte alignment slot with no
+// trailing padding -- not a concern without USES_LOCKWORD, where the 8-byte
+// header always leaves >=8 padding bytes, but this must not assume that
+// either way). Objects that fail this check are excluded from evacuation
+// candidacy entirely, via the same per-block pinning mechanism used for
+// conservative-root pins (see EvacPin_record) -- checked once, right where
+// the live-byte tally already computes each object's size during marking.
+static inline bool Evac_CanForward(size_t objectSize) {
+    return objectSize >= EVAC_FORWARD_OFFSET + sizeof(word_t);
+}
+
+/* ---- Debug-only live-heap histogram ---------------------------------
+ * Not part of upstream scala-native. Tallies, per mark cycle, how many
+ * live objects of each runtime type are reachable and how many bytes
+ * they occupy -- the thing `jmap -histo:live` gives on a JVM but that
+ * scala-native's own GC has no equivalent of. Reset at the start of
+ * every `Marker_Mark` (so each dump is one cycle's live-set census, not
+ * a running total across cycles -- Immix remarks every live object from
+ * roots on every collection) and appended to
+ * $SCALANATIVE_HEAP_HISTOGRAM_FILE (if set) once that cycle's mark
+ * phase completes, so a series of dumps forms a real time series of the
+ * live set as a program runs, correlatable against externally-sampled
+ * RSS by wall-clock timestamp. Zero-cost when the env var is unset
+ * (checked once, cached).
+ */
+#define HISTOGRAM_CAPACITY 65536
+#define HISTOGRAM_NAME_MAX 96
+typedef struct {
+    int32_t id;    // 0 means empty slot (real rtti ids are never 0)
+    uint64_t count;
+    uint64_t bytes;
+    char name[HISTOGRAM_NAME_MAX];
+} HistogramSlot;
+
+static HistogramSlot histogramTable[HISTOGRAM_CAPACITY];
+static int histogramEnabledChecked = 0;
+static const char *histogramFilePath = NULL;
+static uint64_t histogramCycle = 0;
+
+static inline int Histogram_enabled(void) {
+    if (!histogramEnabledChecked) {
+        histogramFilePath = getenv("SCALANATIVE_HEAP_HISTOGRAM_FILE");
+        histogramEnabledChecked = 1;
+    }
+    return histogramFilePath != NULL;
+}
+
+static void Histogram_reset(void) {
+    memset(histogramTable, 0, sizeof(histogramTable));
+}
+
+static void Histogram_record(Object *object) {
+    int32_t id = object->rtti->rt.id;
+    if (id == 0)
+        return; // shouldn't happen, but never collide with "empty slot"
+    uint64_t size = (uint64_t)Object_Size(object);
+    uint32_t idx = ((uint32_t)id) % HISTOGRAM_CAPACITY;
+    for (int probes = 0; probes < HISTOGRAM_CAPACITY; probes++) {
+        HistogramSlot *slot = &histogramTable[idx];
+        if (slot->id == 0) {
+            slot->id = id;
+            slot->count = 1;
+            slot->bytes = size;
+            wchar_t *wname = Object_nameWString(object);
+            if (wname != NULL) {
+                size_t i = 0;
+                for (; i < HISTOGRAM_NAME_MAX - 1 && wname[i] != 0; i++) {
+                    wint_t c = (wint_t)wname[i];
+                    slot->name[i] = (c >= 32 && c < 127) ? (char)c : '?';
+                }
+                slot->name[i] = 0;
+                free(wname);
+            } else {
+                slot->name[0] = 0;
+            }
+            return;
+        } else if (slot->id == id) {
+            slot->count += 1;
+            slot->bytes += size;
+            return;
+        }
+        idx = (idx + 1) % HISTOGRAM_CAPACITY;
+    }
+    // Table genuinely full (didn't happen in testing at 65536 slots for a
+    // ~13-20k-class program) -- silently drop rather than corrupt memory.
+}
+
+static int Histogram_compareByBytesDesc(const void *a, const void *b) {
+    uint64_t ba = ((const HistogramSlot *)a)->bytes;
+    uint64_t bb = ((const HistogramSlot *)b)->bytes;
+    if (ba > bb)
+        return -1;
+    if (ba < bb)
+        return 1;
+    return 0;
+}
+
+static void Histogram_dump(Heap *heap) {
+    if (!Histogram_enabled())
+        return;
+    // static, not stack-local: HISTOGRAM_CAPACITY * sizeof(HistogramSlot) is
+    // ~7-8MB, too large to put on a thread stack during a GC pause.
+    static HistogramSlot sorted[HISTOGRAM_CAPACITY];
+    memcpy(sorted, histogramTable, sizeof(histogramTable));
+    qsort(sorted, HISTOGRAM_CAPACITY, sizeof(HistogramSlot),
+          Histogram_compareByBytesDesc);
+
+    FILE *f = fopen(histogramFilePath, "a");
+    if (f == NULL)
+        return;
+    double wallSeconds = (double)Time_current_nanos() / 1e9;
+    uint64_t totalObjects = 0, totalBytes = 0;
+    for (int i = 0; i < HISTOGRAM_CAPACITY; i++) {
+        if (histogramTable[i].id != 0) {
+            totalObjects += histogramTable[i].count;
+            totalBytes += histogramTable[i].bytes;
+        }
+    }
+    // Three independently-sourced numbers, sampled from inside this same
+    // call so they share one clock and one instant -- no cross-process
+    // clock alignment needed, unlike correlating this file against an
+    // externally-polled `ps`/`vm_stat` log:
+    //  - totalBytes: sum of live-object sizes from this mark cycle (the
+    //    histogram above) -- what the GC can account for as reachable.
+    //  - gcHeapUsedBytes: `heap->heapSize` (Heap_getMemoryUsed) -- the
+    //    Immix allocator's own committed/grown heap size, independent of
+    //    how much of it is actually live vs. garbage-but-unswept.
+    //  - processPeakRssBytes: this process's own peak RSS via getrusage,
+    //    so real OS-level memory pressure is on the exact same timeline
+    //    as the two GC-internal numbers, not approximated from outside.
+    size_t gcHeapUsedBytes = Heap_getMemoryUsed(heap);
+    unsigned long long processPeakRssBytes = 0;
+#if defined(HISTOGRAM_HAS_GETRUSAGE)
+    struct rusage ru;
+    if (getrusage(RUSAGE_SELF, &ru) == 0) {
+#if defined(__APPLE__)
+        processPeakRssBytes = (unsigned long long)ru.ru_maxrss; // bytes
+#else
+        processPeakRssBytes = (unsigned long long)ru.ru_maxrss * 1024ULL; // KB->bytes
+#endif
+    }
+#endif
+    fprintf(f,
+            "--- cycle=%llu wall_seconds=%.3f total_objects=%llu "
+            "total_bytes=%llu gc_heap_used_bytes=%llu "
+            "process_peak_rss_bytes=%llu ---\n",
+            (unsigned long long)histogramCycle, wallSeconds,
+            (unsigned long long)totalObjects,
+            (unsigned long long)totalBytes,
+            (unsigned long long)gcHeapUsedBytes, processPeakRssBytes);
+    fprintf(f, "id,count,bytes,name\n");
+    for (int i = 0; i < HISTOGRAM_CAPACITY; i++) {
+        HistogramSlot *slot = &sorted[i];
+        if (slot->id == 0)
+            continue;
+        fprintf(f, "%d,%llu,%llu,%s\n", slot->id,
+                (unsigned long long)slot->count,
+                (unsigned long long)slot->bytes, slot->name);
+    }
+    fclose(f);
+    histogramCycle++;
+}
+/* ---------------------------------------------------------------------- */
+
+/* ---- Debug-only evacuation-candidate scoring (stage 1: measurement only,
+ * NO objects are moved by this code -- it only tallies real live bytes per
+ * block during marking and logs how many blocks are sparsely-occupied
+ * ("unavailable" to the line-granularity sweep in Block_Recycle -- every
+ * line in the block has at least one survivor -- but with real live-byte
+ * occupancy far below capacity), and how many bytes evacuating those blocks
+ * *would* reclaim. This validates whether real evacuation is worth building
+ * (stage 2) before writing any code that actually moves objects and rewrites
+ * pointers, which is a correctness-critical change this project is treating
+ * with real caution -- see the investigation in project memory /
+ * docs/findings.md before extending this into a real evacuating collector.
+ * Gated behind $SCALANATIVE_EVAC_LOG_FILE, zero-cost (one getenv check,
+ * cached) when unset. */
+static int evacLogEnabledChecked = 0;
+static const char *evacLogFilePath = NULL;
+static uint32_t *blockLiveBytes = NULL;
+static uint32_t blockLiveBytesCapacity = 0;
+// Set once per cycle by Marker_Mark (whether logging OR real evacuation is
+// on), read from Marker_markConservative -- see the pinning section below.
+static int g_evacTrackingOn = 0;
+// Per-block "at least one object in this block was reached only via a
+// conservative scan this cycle" flag. See the pinning explanation in the
+// Stage 2 section below (search "PINNING") for why this exists -- it's the
+// fix for a real, reproduced memory-corruption bug, not speculative
+// hardening.
+static uint8_t *blockPinned = NULL;
+static uint32_t blockPinnedCapacity = 0;
+
+static void EvacPin_ensureCapacity(uint32_t blockCount) {
+    if (blockCount > blockPinnedCapacity) {
+        blockPinned = (uint8_t *)realloc(blockPinned, (size_t)blockCount);
+        blockPinnedCapacity = blockCount;
+    }
+}
+
+static void EvacPin_reset(uint32_t blockCount) {
+    EvacPin_ensureCapacity(blockCount);
+    memset(blockPinned, 0, (size_t)blockCount);
+}
+
+static inline void EvacPin_record(Heap *heap, Object *object) {
+    uint32_t blockIndex =
+        Block_GetBlockIndexForWord(heap->heapStart, (word_t *)object);
+    if (blockIndex < blockPinnedCapacity) {
+        blockPinned[blockIndex] = 1;
+    }
+}
+
+static inline bool EvacPin_isBlockPinned(uint32_t blockIndex) {
+    return blockIndex < blockPinnedCapacity && blockPinned[blockIndex] != 0;
+}
+
+static inline int EvacLog_enabled(void) {
+    if (!evacLogEnabledChecked) {
+        evacLogFilePath = getenv("SCALANATIVE_EVAC_LOG_FILE");
+        evacLogEnabledChecked = 1;
+    }
+    return evacLogFilePath != NULL;
+}
+
+static void EvacLog_ensureCapacity(uint32_t blockCount) {
+    if (blockCount > blockLiveBytesCapacity) {
+        size_t bytes = (size_t)blockCount * sizeof(uint32_t);
+        blockLiveBytes = (uint32_t *)realloc(blockLiveBytes, bytes);
+        blockLiveBytesCapacity = blockCount;
+    }
+}
+
+static void EvacLog_reset(uint32_t blockCount) {
+    EvacLog_ensureCapacity(blockCount);
+    memset(blockLiveBytes, 0, (size_t)blockCount * sizeof(uint32_t));
+}
+
+static inline void EvacLog_recordLiveObject(Heap *heap, Object *object) {
+    uint32_t blockIndex =
+        Block_GetBlockIndexForWord(heap->heapStart, (word_t *)object);
+    size_t size = Object_Size(object);
+    if (blockIndex < blockLiveBytesCapacity) {
+        blockLiveBytes[blockIndex] += (uint32_t)size;
+    }
+    if (!Evac_CanForward(size)) {
+        EvacPin_record(heap, object);
+    }
+}
+
+static void EvacLog_dump(Heap *heap, uint64_t cycle) {
+    if (!EvacLog_enabled())
+        return;
+    FILE *f = fopen(evacLogFilePath, "a");
+    if (f == NULL)
+        return;
+    uint32_t blockCount = heap->blockCount;
+    uint32_t candidateBlocks = 0;
+    uint64_t candidateReclaimableBytes = 0;
+    uint64_t candidateLiveBytes = 0;
+    // Blocks under this real live-byte occupancy fraction are candidates --
+    // matches the classic Immix opportunistic-defrag threshold range.
+    const double kOccupancyThreshold = 0.35;
+    uint32_t limit = blockCount < blockLiveBytesCapacity ? blockCount
+                                                         : blockLiveBytesCapacity;
+    for (uint32_t i = 0; i < limit; i++) {
+        BlockMeta *meta =
+            BlockMeta_GetFromIndex(heap->blockMetaStart, i);
+        // Skip fully-free blocks (nothing to reclaim), large-object
+        // superblocks (out of scope here), and pinned blocks (contain an
+        // object reachable only via a conservative scan -- see PINNING in
+        // the Stage 2 section; real evacuation skips these too, so this
+        // logging matches what evacuation would actually do).
+        if (BlockMeta_IsFree(meta) || BlockMeta_ContainsLargeObjects(meta) ||
+            EvacPin_isBlockPinned(i))
+            continue;
+        uint32_t liveBytes = blockLiveBytes[i];
+        if (liveBytes > 0 &&
+            liveBytes < (uint32_t)(BLOCK_TOTAL_SIZE * kOccupancyThreshold)) {
+            candidateBlocks++;
+            candidateLiveBytes += liveBytes;
+            candidateReclaimableBytes += (BLOCK_TOTAL_SIZE - liveBytes);
+        }
+    }
+    fprintf(f,
+            "cycle=%llu blockCount=%u candidateBlocks=%u "
+            "candidateLiveBytes=%llu candidateReclaimableBytes=%llu\n",
+            (unsigned long long)cycle, blockCount, candidateBlocks,
+            (unsigned long long)candidateLiveBytes,
+            (unsigned long long)candidateReclaimableBytes);
+    fclose(f);
+}
+/* ---------------------------------------------------------------------- */
+
 #define LAST_FIELD_OFFSET -1
 
+/* ---- Stage 2: real opportunistic evacuation (MOVES OBJECTS) --------------
+ * Not part of upstream scala-native. This is a correctness-critical change
+ * -- see project memory / docs/findings.md for the full investigation and
+ * staging rationale before touching this. Strictly opt-in via
+ * $SCALANATIVE_EVAC_ENABLE (unset = zero behavior change, same as every
+ * other flag in this file). Validated first via the measurement-only
+ * candidate scoring above (stage 1): on the real workload this exists for,
+ * 95%+ of committed blocks were evacuation candidates holding <35% real
+ * live-byte occupancy, so real evacuation was judged worth the risk.
+ *
+ * KNOWN, DELIBERATELY UNADDRESSED GAP: `java.lang.System.identityHashCode`
+ * is the raw object address (javalib System.scala), and `IdentityHashMap`
+ * buckets keys by it. Moving an object after it's been used as a key
+ * silently produces wrong lookups (not a crash). Not fixed here -- would
+ * need a stable hash assigned independent of address, real separate work.
+ * Do not enable this for any workload that populates an IdentityHashMap (or
+ * relies on identityHashCode) over long-lived GC objects before a
+ * collection can run.
+ *
+ * KNOWN, DELIBERATELY UNADDRESSED EDGE CASE: the conservative "boxed
+ * pointer" scan (`__boxed_ptr_id`, `Marker_markConservative`) is not
+ * fixed up by the rewrite pass below. A raw native pointer that happens to
+ * alias a forwarded object's old address will not be corrected. This is an
+ * FFI/native-interop path, not expected to matter for this project's own
+ * compiler/linker workload, but is a real gap if this were ever used more
+ * broadly.
+ *
+ * Sequencing (see Heap_Collect in Heap.c): Marker_MarkRoots -> mark phase
+ * (incl. the live-byte tally above) -> WeakReferences_Nullify -> *this* ->
+ * Heap_Recycle. Running after WeakReferences_Nullify means weak-reference
+ * fields are already resolved to either null or a real surviving referent
+ * by the time this runs, so they're just another field to fix up, not a
+ * liveness decision -- unlike normal marking, the rewrite pass below does
+ * NOT skip the weak-referent field (Object_IsReferantOfWeakReference),
+ * since skipping it here would leave it silently pointing at stale memory.
+ */
+static Rtti EvacForwardedRtti; // sentinel; address compared, never dereferenced
+
+static inline bool Evac_IsForwarded(Object *object) {
+    return object->rtti == &EvacForwardedRtti;
+}
+
+static inline word_t *Evac_ForwardedAddress(Object *object) {
+    return *(word_t **)((uint8_t *)object + EVAC_FORWARD_OFFSET);
+}
+
+static inline void Evac_SetForwarded(Object *object, word_t *newAddr) {
+    object->rtti = &EvacForwardedRtti;
+    *(word_t **)((uint8_t *)object + EVAC_FORWARD_OFFSET) = newAddr;
+}
+
+static int evacEnabledChecked = 0;
+static int evacEnabledValue = 0;
+
+static inline int Evac_enabled(void) {
+    if (!evacEnabledChecked) {
+        evacEnabledValue = getenv("SCALANATIVE_EVAC_ENABLE") != NULL;
+        evacEnabledChecked = 1;
+    }
+    return evacEnabledValue;
+}
+
+// Blocks under this real live-byte occupancy fraction are evacuated.
+// Matches the threshold already validated via the stage-1 candidate log.
+#define EVAC_OCCUPANCY_THRESHOLD 0.35
+
+static inline bool Evac_IsCandidateBlock(BlockMeta *meta, uint32_t liveBytes,
+                                         uint32_t blockIndex) {
+    // PINNING: a block containing any object reached only via a
+    // conservative scan is never a candidate, regardless of occupancy --
+    // see the comment in Marker_markConservative for why. blockPinned is
+    // populated (or left all-zero, if EvacPin_reset was never called
+    // because tracking was off) before this is ever consulted.
+    return !BlockMeta_IsFree(meta) && !BlockMeta_ContainsLargeObjects(meta) &&
+           !EvacPin_isBlockPinned(blockIndex) && liveBytes > 0 &&
+           liveBytes < (uint32_t)(BLOCK_TOTAL_SIZE * EVAC_OCCUPANCY_THRESHOLD);
+}
+
+// One field slot, wherever it came from (object field, array element, root):
+// if it currently holds the OLD address of an object we just evacuated,
+// rewrite it to that object's new address. Leaves every other value (null,
+// non-heap pointer, pointer to a non-forwarded live object) untouched.
+static inline void Evac_FixupSlot(Heap *heap, word_t **slot) {
+    word_t *value = *slot;
+    if (value != NULL && Heap_IsWordInHeap(heap, value) &&
+        Bytemap_isPtrAligned(value)) {
+        ObjectMeta *meta = Bytemap_Get(heap->bytemap, value);
+        // Forwarded objects are marked (they were live, real objects before
+        // being evacuated) -- IsAllocated/IsMarked both fine, just needs to
+        // not be free/placeholder before it's safe to read ->rtti.
+        if (!ObjectMeta_IsFree(meta) && !ObjectMeta_IsPlaceholder(meta)) {
+            Object *object = (Object *)value;
+            if (Evac_IsForwarded(object)) {
+                *slot = Evac_ForwardedAddress(object);
+            }
+        }
+    }
+}
+
+static void Evac_FixupRange(Heap *heap, word_t **from, word_t **to,
+                            size_t stride) {
+    if (from > to) {
+        word_t **tmp = from;
+        from = to;
+        to = tmp;
+    }
+    const intptr_t alignmentMask = ~(sizeof(word_t) - 1);
+    ubyte_t *alignedFrom = (ubyte_t *)((intptr_t)from & alignmentMask);
+    ubyte_t *alignedTo = (ubyte_t *)((intptr_t)to & alignmentMask);
+    for (ubyte_t *current = alignedFrom; current < alignedTo;
+         current += stride) {
+        Evac_FixupSlot(heap, (word_t **)current);
+    }
+}
+
+static void Evac_FixupProgramStack(MutatorThread *thread, Heap *heap) {
+    word_t **stackBottom = MutatorThread_getStackBottom(thread);
+    word_t **stackTop = NULL;
+    do {
+        stackTop = MutatorThread_getStackTop(thread, false);
+    } while (stackTop == NULL);
+#ifdef SCALANATIVE_THREAD_ALT_STACK
+    if (thread->threadInfo != NULL &&
+        !isInRange(stackTop, thread->threadInfo->stackTop,
+                   thread->threadInfo->stackBottom)) {
+        void *stackScanLimit = threadStackScanableLimit(thread->threadInfo);
+        stackTop = (stackScanLimit != NULL)
+                       ? (word_t **)stackScanLimit
+                       : stackBottom - 64 * 1024;
+        if (thread->threadInfo->signalHandlerStack != NULL) {
+            word_t **signalHandlerStack =
+                (word_t **)thread->threadInfo->signalHandlerStack;
+            Evac_FixupRange(
+                heap, signalHandlerStack,
+                (word_t **)((char *)signalHandlerStack +
+                            thread->threadInfo->signalHandlerStackSize),
+                sizeof(word_t));
+        }
+    }
+#endif
+    Evac_FixupRange(heap, stackTop, stackBottom, sizeof(word_t));
+    size_t registerBufferStride =
+#if defined(CAPTURE_SETJMP)
+        sizeof(uint32_t);
+#else
+        sizeof(word_t);
+#endif
+    Evac_FixupRange(heap, (word_t **)&thread->registersBuffer,
+                    (word_t **)(&thread->registersBuffer + 1),
+                    registerBufferStride);
+}
+
+static void Evac_FixupModules(Heap *heap) {
+    word_t **modules = &__modules;
+    int nb_modules = __modules_size;
+    for (int i = 0; i < nb_modules; i++) {
+        Evac_FixupSlot(heap, (word_t **)&modules[i]);
+    }
+}
+
+static void Evac_FixupCustomRoots(Heap *heap, GC_Roots *roots) {
+    mutex_lock(&roots->modificationLock);
+    for (GC_Root *it = roots->head; it != NULL; it = it->next) {
+        Evac_FixupRange(heap, (word_t **)it->range.address_low,
+                        (word_t **)it->range.address_high, sizeof(word_t));
+    }
+    mutex_unlock(&roots->modificationLock);
+}
+
+// Rewrites every field of every currently-marked object in currently-marked
+// simple blocks. Runs AFTER copying, so this naturally covers both (a)
+// survivors that stayed in place (non-candidate blocks, still marked) and
+// (b) freshly-copied objects in the destination blocks (marked via
+// Object_Mark during the copy loop below) -- and naturally skips evacuated
+// source blocks, since those get BlockMeta_Unmark'd before this runs.
+static void Evac_FixupHeapObjects(Heap *heap) {
+    Bytemap *bytemap = heap->bytemap;
+    for (uint32_t i = 0; i < heap->blockCount; i++) {
+        BlockMeta *meta = BlockMeta_GetFromIndex(heap->blockMetaStart, i);
+        if (!BlockMeta_IsMarked(meta) || BlockMeta_ContainsLargeObjects(meta))
+            continue;
+        word_t *blockStart = heap->heapStart + (size_t)i * WORDS_IN_BLOCK;
+        word_t *blockEnd = blockStart + WORDS_IN_BLOCK;
+        for (word_t *addr = blockStart; addr < blockEnd;) {
+            ObjectMeta *objMeta = Bytemap_Get(bytemap, addr);
+            if (ObjectMeta_IsMarked(objMeta)) {
+                Object *object = (Object *)addr;
+                const int objectId = object->rtti->rt.id;
+                if (Object_IsArray(object)) {
+                    ArrayHeader *arrayHeader = (ArrayHeader *)object;
+                    if (objectId == __object_array_id) {
+                        const size_t length = arrayHeader->length;
+                        word_t **fields = (word_t **)(arrayHeader + 1);
+                        for (size_t k = 0; k < length; k++) {
+                            Evac_FixupSlot(heap, &fields[k]);
+                        }
+                    }
+                    // blob arrays hold no pointers -- nothing to fix up
+                } else {
+                    int32_t *refFieldOffsets = object->rtti->refFieldOffsets;
+                    for (int k = 0; refFieldOffsets[k] != LAST_FIELD_OFFSET;
+                         k++) {
+                        size_t fieldOffset = (size_t)refFieldOffsets[k];
+                        word_t **fieldRef =
+                            (word_t **)((int8_t *)object + fieldOffset);
+                        // Deliberately NOT skipping the weak-referent field
+                        // here (unlike marking) -- see file header comment.
+                        Evac_FixupSlot(heap, fieldRef);
+                    }
+                    // The __boxed_ptr_id conservative-scan case is
+                    // deliberately not fixed up -- see file header comment.
+                }
+                addr += Object_Size(object) / sizeof(word_t);
+            } else {
+                addr += ALLOCATION_ALIGNMENT_WORDS;
+            }
+        }
+    }
+}
