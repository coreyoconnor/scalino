+    def digest(): Array[Byte] = {
+      val bitLen = messageLen * 8
+      updateByte(0x80.toByte)
+      while (bufferLen != 56) updateByte(0.toByte)
+      var i = 7
+      while (i >= 0) {
+        updateByte(((bitLen >>> (i * 8)) & 0xff).toByte)
+        i -= 1
+      }
