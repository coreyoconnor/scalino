+      val result = new Array[Byte](20)
+      val words = Array(h0, h1, h2, h3, h4)
+      i = 0
+      while (i < 5) {
+        result(i * 4) = ((words(i) >>> 24) & 0xff).toByte
+        result(i * 4 + 1) = ((words(i) >>> 16) & 0xff).toByte
+        result(i * 4 + 2) = ((words(i) >>> 8) & 0xff).toByte
+        result(i * 4 + 3) = (words(i) & 0xff).toByte
+        i += 1
+      }
+      result
+    }
+  }
