+// Not part of upstream scala-native. Without this, arm64/Apple Silicon (and
+// any other non-Windows aarch64 target) had NO dedicated case here at all --
+// it silently fell through to the generic CAPTURE_SETJMP fallback below,
+// scanning a `jmp_buf` as if it were a plain array of words. A real,
+// reproduced bug (a live reference sitting only in a callee-saved register
+// across a call was missed by both marking's conservative root scan and a
+// GC evacuation pass's pointer-rewrite pass -- confirmed via a debugger:
+// the object it pointed at was correctly moved with a valid forwarding
+// record left behind, but this specific reference to it was simply never
+// found) traces back to this gap. Whether `jmp_buf`'s layout on a given
+// libc is even safe to scan as raw pointer-sized words at all is
+// unspecified by POSIX -- capturing the real, named architectural
+// registers explicitly, the same way the i386/x86_64 cases already do,
+// removes that uncertainty entirely rather than trying to characterize it.
+// Scope: AAPCS64's callee-saved general-purpose registers (x19-x28) plus
+// the frame pointer (x29/fp) -- exactly the registers a function can hold
+// a live object reference in across a call without spilling to the stack.
+// x30 (link register, a return address, not a data pointer) and the
+// callee-saved SIMD registers (d8-d15) are deliberately not captured,
+// matching this codebase's own existing rationale elsewhere that only
+// general-purpose registers plausibly hold object references under normal
+// Scala Native codegen. Windows on arm64 is explicitly out of scope here
+// (falls through to CAPTURE_SETJMP, unchanged from before this file
+// existed) -- RtlCaptureContext's arm64 CONTEXT layout would need its own,
+// separately-verified implementation, not guessed at alongside this fix.
+#define CAPTURE_ARM64
+typedef struct RegistersBuffer {
+    void *x19;
+    void *x20;
+    void *x21;
+    void *x22;
+    void *x23;
+    void *x24;
+    void *x25;
+    void *x26;
+    void *x27;
+    void *x28;
