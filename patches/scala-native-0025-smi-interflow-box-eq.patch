@@ -417,6 +417,43 @@ private[interflow] trait Combine { self: Interflow =>
     import state.{materialize, delay, emit}
 
     (comp, l, r) match {
+      // SMI-style tagged-pointer boxing (see nir.Type.Smi) makes two
+      // independently-boxed *same-valued* instances of an SMI-eligible
+      // type genuinely pointer-equal at runtime on 64-bit targets (same
+      // tag bits computed from the same payload), even though Interflow's
+      // abstract heap models them as two distinct virtual addresses. The
+      // address-identity rule below this case predates SMI and is still
+      // correct for ordinary heap-allocated objects (and for box types
+      // that stay real allocations, e.g. Long/Double, or on 32-bit), but
+      // it is wrong for these - handle them first.
+      case (
+            Ieq | Ine,
+            VirtualRef(BoxKind, lcls, Array(lval)),
+            VirtualRef(BoxKind, rcls, Array(rval))
+          )
+          if !platform.is32Bit &&
+            nir.Type.Smi.isEligibleBoxType(nir.Type.Ref(lcls.name)) =>
+        if (lcls.name != rcls.name) {
+          // Different box classes (different discriminant) can never be
+          // pointer-equal, tagged or not.
+          nir.Val.Bool(comp == Ine)
+        } else if (lval.isCanonical && rval.isCanonical) {
+          // Both payloads are known at compile time: equal payloads mean
+          // identical tag bits (genuinely eq), different payloads mean
+          // different tag bits (genuinely not eq) - true regardless of
+          // whether either side ends up tagged or materialized as a real
+          // object, since the encoding is a deterministic function of the
+          // payload alone (see Lower.genSmiBoxOp).
+          nir.Val.Bool((lval == rval) == (comp == Ieq))
+        } else {
+          // Payload not known until runtime: can't fold either way.
+          // Materializing goes through `Op.Box` (State.materialize's
+          // BoxKind case), not `Op.Classalloc`, so both sides stay on the
+          // SMI-aware codegen path - the real comparison Lower emits is
+          // correct whether it ends up comparing tag bits or addresses.
+          emit(nir.Op.Comp(comp, ty, materialize(l), materialize(r)))
+        }
+
       // Two virtual allocations will compare equal if
       // and only if they have the same virtual address.
       case (Ieq, nir.Val.Virtual(l), nir.Val.Virtual(r))
