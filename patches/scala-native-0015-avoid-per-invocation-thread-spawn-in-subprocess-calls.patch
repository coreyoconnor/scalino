+  /** Runs `cmd` to completion, logging its merged stdout/stderr via `logger`.
+   *
+   *  Uses `java.lang.ProcessBuilder` directly and reads its output on the
+   *  calling thread instead of `scala.sys.process`'s `Process(...) !`, which
+   *  spawns 2-3 short-lived reader/wait threads per invocation -- with one
+   *  call per compiled unit, that added up to hundreds of throwaway OS
+   *  threads over a build.
+   */
+  private def runProcess(
+      cmd: Seq[String],
+      cwd: File,
+      logger: Logger,
+      stdin: Option[File] = None
+  ): Int = {
+    val pb = new java.lang.ProcessBuilder(cmd*)
+      .directory(cwd)
+      .redirectErrorStream(true)
+    stdin.foreach(pb.redirectInput)
+    val proc = pb.start()
+    val reader = new BufferedReader(new InputStreamReader(proc.getInputStream))
+    var line = reader.readLine()
+    while (line != null) {
+      logger.info(line)
+      line = reader.readLine()
+    }
+    proc.waitFor()
+  }
+
+  /** An external command to run via [[runProcess]]. */
+  private final case class Cmd(
+      args: Seq[String],
+      cwd: File,
+      stdin: Option[File] = None
+  )
