diff --git a/nativelib/src/main/resources/scala-native/gc/commix/Heap.c b/nativelib/src/main/resources/scala-native/gc/commix/Heap.c
index 01e41ca..ed745ac 100644
--- a/nativelib/src/main/resources/scala-native/gc/commix/Heap.c
+++ b/nativelib/src/main/resources/scala-native/gc/commix/Heap.c
@@ -264,6 +264,18 @@ void Heap_Collect(Heap *heap) {
                       heap->mark.currentEnd_ns);
     Phase_Nullify(heap, stats);
     Phase_StartSweep(heap);
+#ifdef SCALANATIVE_GC_COMMIX_STW_SWEEP
+    // Throughput-oriented mode: keep mutators paused through the parallel
+    // sweep too, instead of resuming them immediately (commix's normal
+    // behavior). Sweep is already driven by the same parallel GCThread pool
+    // used for marking (Phase_StartSweep above woke it), so this just waits
+    // for that existing parallel sweep to finish before releasing the STW
+    // pause, trading concurrency for avoiding the lazy/concurrent-sweep
+    // bookkeeping mutators otherwise pay per allocation.
+    while (!Sweeper_IsSweepDone(heap)) {
+        thread_yield();
+    }
+#endif
 #ifdef SCALANATIVE_MULTITHREADING_ENABLED
     Synchronizer_release();
 #else
