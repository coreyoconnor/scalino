diff --git a/tools/src/main/scala/scala/scalanative/build/NativeConfig.scala b/tools/src/main/scala/scala/scalanative/build/NativeConfig.scala
index 459efde..89972ad 100644
--- a/tools/src/main/scala/scala/scalanative/build/NativeConfig.scala
+++ b/tools/src/main/scala/scala/scalanative/build/NativeConfig.scala
@@ -127,6 +127,19 @@ sealed trait NativeConfig {
   private[scalanative] def multithreadingSupport: Boolean =
     multithreading.getOrElse(true)
 
+  /** EXPERIMENTAL, commix GC only. Keep mutator threads fully paused through
+   *  the parallel sweep phase instead of resuming them as soon as marking
+   *  finishes (commix's normal behavior). Commix's marking phase is already
+   *  parallel-STW (all mutators stay paused while multiple GC worker threads
+   *  drain the grey-packet queue); only sweep is normally allowed to run
+   *  concurrently with resumed mutators, at the cost of per-allocation
+   *  lazy-sweep bookkeeping mutators otherwise pay. When throughput matters
+   *  more than pause-time/concurrency, this trades that resumption back for
+   *  a longer, fully parallel STW pause with none of that bookkeeping.
+   *  Default `false`.
+   */
+  def gcStwSweep: Boolean
+
   /** Map of user defined properties resolved at linktime */
   def linktimeProperties: NativeConfig.LinktimeProperites
 
