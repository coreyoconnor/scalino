index 0000000..d52e82c
--- /dev/null
+++ b/nativelib/src/main/scala/scala/scalanative/runtime/SmiBox.scala
@@ -0,0 +1,76 @@
+package scala.scalanative.runtime
+
+import scala.scalanative.runtime.Intrinsics._
+
+/** Runtime-side counterpart of the compiler's SMI-style tagged-pointer
+ *  boxing scheme (see `nir.Type.Smi` in the `nir` module for the bit-layout
+ *  single source of truth; it can't be shared by reference with this module
+ *  since `nir`/`tools` are compiler-side Scala/JVM code and this module is
+ *  compiled *into* the target program - the encoding is mirrored here by
+ *  value instead).
+ *
+ *  Word layout (64-bit, LSB-first):
+ *  {{{
+ *  bit 0       : tag           0 = real pointer, 1 = tagged immediate
+ *  bits 1-5    : discriminant  5 bits, 6 of 32 values used currently
+ *  bits 6-63   : payload       58 bits, value stored left-justified
+ *  }}}
+ */
+object SmiBox {
+  private final val PayloadShift = 6
+  private final val DiscriminantMask = 0x1FL
+
+  @inline def isTagged(obj: RawPtr): Boolean =
+    (castRawPtrToLong(obj) & 1L) != 0L
+
+  @inline def discriminant(obj: RawPtr): Int =
+    ((castRawPtrToLong(obj) >>> 1) & DiscriminantMask).toInt
+
+  @inline private def payloadOf(obj: RawPtr): Long =
+    castRawPtrToLong(obj) >> PayloadShift // arithmetic shift: sign-preserving
+
+  // Per-type payload decoders. Used both by `reify` below and - more
+  // importantly - directly by the 6 box classes' own `_value` accessors
+  // (java.lang.{Boolean,Byte,Short,Character,Integer,Float}), so that a
+  // method resolved via *static* (non-virtual) dispatch in `codegen.Lower`
+  // - which never goes through `Lower`'s reify-on-tag fallback, since it
+  // doesn't inspect the receiver at all - still works correctly when handed
+  // a tagged `this`: the field access inside the method body decodes the
+  // tag itself instead of assuming a real, allocated object.
+  @inline def decodeBoolean(obj: RawPtr): scala.Boolean = payloadOf(obj) != 0L
+  @inline def decodeByte(obj: RawPtr): scala.Byte = payloadOf(obj).toByte
+  @inline def decodeShort(obj: RawPtr): scala.Short = payloadOf(obj).toShort
+  @inline def decodeChar(obj: RawPtr): scala.Char =
+    (payloadOf(obj) & 0xFFFFL).toChar
+  @inline def decodeInt(obj: RawPtr): scala.Int = payloadOf(obj).toInt
+  @inline def decodeFloat(obj: RawPtr): scala.Float =
+    java.lang.Float.intBitsToFloat(payloadOf(obj).toInt)
+
+  /** Materializes a real, heap-allocated `java.lang.X` box object holding
+   *  the same value as the tagged immediate `obj`. Used as the fallback
+   *  path for the (rare) virtual dispatch / reflective-call / dynmethod
+   *  sites that don't have a dedicated fast path for tagged values: reify
+   *  once, then let the ordinary header-based dispatch machinery handle the
+   *  rest exactly as it would for any other real object.
+   *
+   *  Deliberately does NOT go through `Op.Box`/`BoxesRunTime` (which, for
+   *  these same 6 types on 64-bit, the compiler now lowers back into an
+   *  inline tag - that would be a no-op here). `new java.lang.X(...)`
+   *  compiles to `Op.Classalloc`, an entirely separate NIR path untouched
+   *  by the tagged-boxing change, so it always allocates a genuine object.
+   */
+  def reify(obj: RawPtr): AnyRef = {
+    discriminant(obj) match {
+      case 0 => new java.lang.Boolean(decodeBoolean(obj))
+      case 1 => new java.lang.Byte(decodeByte(obj))
+      case 2 => new java.lang.Short(decodeShort(obj))
+      case 3 => new java.lang.Character(decodeChar(obj))
+      case 4 => new java.lang.Integer(decodeInt(obj))
+      case 5 => new java.lang.Float(decodeFloat(obj))
+      case other =>
+        throw new IllegalStateException(
+          s"Unknown SMI discriminant $other in tagged pointer"
+        )
+    }
+  }
+}
