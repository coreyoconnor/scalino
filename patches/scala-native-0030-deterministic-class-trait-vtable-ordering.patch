diff --git a/tools/src/main/scala/scala/scalanative/linker/Infos.scala b/tools/src/main/scala/scala/scalanative/linker/Infos.scala
index b3dee07..5fe0c3c 100644
--- a/tools/src/main/scala/scala/scalanative/linker/Infos.scala
+++ b/tools/src/main/scala/scala/scalanative/linker/Infos.scala
@@ -18,7 +18,16 @@ sealed abstract class ScopeInfo extends Info {
   val calls = mutable.Set.empty[nir.Sig]
   val responds = mutable.Map.empty[nir.Sig, nir.Global.Member]
 
-  def methods = calls.toSeq.filter(_.isVirtual)
+  // Sorted (by Sig.mangle, the only stable key Sig has) so vtable-slot
+  // assignment (VirtualTable.scala) and itable method layout (ITable.scala)
+  // -- both of which number entries by THIS Seq's position -- depend only
+  // on which Sigs are reachable, not on `calls`' own hash-bucket iteration
+  // order, which is insertion-sequence-dependent (calls is populated
+  // incrementally as Reach's single-threaded worklist visits call sites;
+  // an unrelated edit elsewhere in the reachable graph can reorder that
+  // walk's visitation order for the exact same final reachable Sig set,
+  // silently reshuffling every embedded vtable/itable index otherwise).
+  def methods = calls.toSeq.filter(_.isVirtual).sortBy(_.mangle)
 
   def isClass: Boolean = this.isInstanceOf[Class]
   def isTrait: Boolean = this.isInstanceOf[Trait]
@@ -112,7 +121,31 @@ final class Class(
 )(implicit val position: nir.SourcePosition)
     extends ScopeInfo {
   val implementors = mutable.SortedSet[Class](this)
-  val subclasses = mutable.Set.empty[Class]
+  // Was mutable.Set (hash-bucketed by identity hashCode, since Class has no
+  // custom equals/hashCode) -- Metadata.initClassIdsAndRanges walks this set
+  // directly, with no sort of its own, to DFS-number every reachable class
+  // (the dense "class id" embedded in each class's own RTTI struct, plus
+  // the matching subtree instanceof range and @__modules table index --
+  // see RuntimeTypeInformation.scala/ModuleArray.scala). Identity hashCodes
+  // aren't reproducible build-to-build, so that numbering -- and therefore
+  // the emitted bytes for every class's metadata and every instanceof/
+  // dispatch site referencing it -- silently reshuffled on almost any
+  // unrelated change elsewhere in the reachable graph, defeating
+  // IncrementalCodeGenContext's cache almost completely (confirmed
+  // empirically: a same-length string-literal edit in an app's own
+  // Main.scala, with an IDENTICAL reachable class/method count before and
+  // after, changed this same class's own `classId` field from 933 to 4825
+  // between two otherwise-identical builds). SortedSet (mirroring
+  // `implementors` above, same Class.classOrdering -- lexicographic by
+  // Global name) makes DFS sibling-visitation order deterministic; this is
+  // safe for the instanceof range-check invariant, which only needs
+  // pre-order-with-contiguous-subtrees, not any particular sibling order.
+  // Declared type stays mutable.Set (not SortedSet) -- callers outside
+  // SHARED_SOURCES (e.g. Reach.scala) are compiled separately against the
+  // stock published jar's erased `Set`-returning signature for this field;
+  // widening it back here keeps that call site binary-compatible while
+  // still getting deterministic (sorted) iteration at runtime.
+  val subclasses: mutable.Set[Class] = mutable.SortedSet.empty[Class]
   val defaultResponds = mutable.Map.empty[nir.Sig, nir.Global.Member]
   var allocations = 0
   def allocated = allocations > 0
