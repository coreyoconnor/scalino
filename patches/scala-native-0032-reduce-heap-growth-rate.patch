--- a/nativelib/src/main/resources/scala-native/gc/immix_commix/CommonConstants.h	2010-01-01 00:00:00
+++ b/nativelib/src/main/resources/scala-native/gc/immix_commix/CommonConstants.h	2026-09-22 12:52:00
@@ -34,7 +34,30 @@
 #define LARGE_BLOCK_MASK (~((1 << LARGE_OBJECT_MIN_SIZE_BITS) - 1))
 
 #define EARLY_GROWTH_THRESHOLD (128 * 1024 * 1024UL)
-#define EARLY_GROWTH_RATE 2.0
-#define GROWTH_RATE 1.414213562
+// Lowered from the upstream 2.0/sqrt(2) pair. Measured on this project's own
+// workload (self-hosted scalino-linkdriver linking dotc's own NIR, via
+// SCALANATIVE_HEAP_HISTOGRAM_FILE): committed heap peaked at 9-13GB against
+// only ~387MB-850MB of real live-object bytes at the same points -- Immix
+// here is non-evacuating (see scala-native-0007's stage-1-only evacuation),
+// so a block with any surviving line can't be reused without moving objects,
+// and growth compounds fast under a 2x/1.414x multiplier. 1.2/1.1 rebuilt
+// into scalino-linkdriver itself (not just a user project's own binary --
+// see docs/findings.md for why that distinction matters here) measured
+// peak heap down to 6.3GB (~30-45% smaller) and wall-clock 41.0s -> 31.8s
+// (~22% faster) on the same build: 3x more GC cycles (19 -> 60), but each
+// growth step needs far fewer new blocks, so sys time (mmap-heavy heap
+// growth) drops from 28.5s to 11.5s, more than offsetting the extra mark
+// work. More frequent GC pauses under this policy also exposed a real,
+// pre-existing race in the safepoint synchronizer (see
+// scala-native-0033-fix-stale-safepoint-trap-race.patch) -- fixed
+// separately, not a reason to avoid this change. Do not lower further
+// without also widening BlockMeta's `first` field (metadata/BlockMeta.h) --
+// LINE_SIZE_BITS has a similar-looking knob right above this one that
+// looks equally safe to tune and is NOT: it silently overflows that packed
+// int8_t once LINE_COUNT exceeds 128, crashing scalino-linkdriver's own GC
+// (SIGSEGV in Allocator_allocSlow, reproduced) in release builds where the
+// guarding assert is stripped.
+#define EARLY_GROWTH_RATE 1.2
+#define GROWTH_RATE 1.1
 
 #endif // IMMIX_COMMON_CONSTANTS_H
