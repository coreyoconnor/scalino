+/*
+ * Registry of every trap page ever allocated by this process, for
+ * SafepointTrapHandler to answer "is this fault address one of OUR OWN
+ * safepoint pages" (see Synchronizer.c's isContinuationStaleTrapFault)
+ * without relying on Synchronizer_stopThreads' current value.
+ *
+ * That boolean is racy against signal delivery: a mutator's stale/delayed
+ * fault (continuation migration, see the file header above) can be
+ * *delivered* to the handler after the STW pause that armed the page has
+ * already ended and stopThreads flipped back to false -- the OS is free to
+ * delay signal delivery arbitrarily, and nothing re-checks stopThreads at
+ * the instant the fault actually occurred, only at the instant the handler
+ * happens to run. When that race lands, the fault -- a completely benign,
+ * structurally-guaranteed-safe stale trap -- falls through the handler's
+ * "is this legitimate" checks and gets treated as a real, unhandled
+ * SIGSEGV/SIGBUS: abort(). Reproduced in practice (SafepointTrapHandler ->
+ * abort, si_code=SEGV_ACCERR) under a heap-growth policy that triggers GC,
+ * and therefore STW pauses, far more often than stock -- more pauses means
+ * more roundtrips through this exact window per unit wall-clock time.
+ *
+ * The fix: page IDENTITY is not racy, only the stopThreads boolean is.
+ * Trap pages are never munmap'd/VirtualFree'd (see the file header above --
+ * a stale TLS-cached pointer must always be safe to dereference), and
+ * nothing else in this process ever mprotects a page for this purpose, so
+ * "this address falls on a page this registry ever recorded" is a
+ * permanent, timing-independent fact from the moment the page is created
+ * for the rest of the process's life. Checking membership instead of the
+ * moment-in-time stopThreads flag is therefore always correct, whether the
+ * fault is handled promptly or arbitrarily late.
+ *
+ * Append-only, fixed capacity (never resized -- a realloc here would need
+ * to be signal-safe on the reader side, which a growing heap allocation
+ * is not): one entry per trap page ever created, which is one per mutator
+ * thread that has EVER existed in this process (pages are recycled via the
+ * freelist above, not one-per-thread-currently-alive), not one per GC
+ * cycle -- 65536 is many times more OS threads than any realistic run of
+ * this project's own multithreaded workloads creates.
+ */
+#define YIELD_POINT_TRAP_REGISTRY_CAPACITY 65536
+static void *YieldPointTrap_registry[YIELD_POINT_TRAP_REGISTRY_CAPACITY];
+static atomic_size_t YieldPointTrap_registryCount = 0;
+
+static void YieldPointTrap_register(void *addr) {
+    // Writers (this function) are NOT signal-handler code -- they run from
+    // ordinary thread context whenever a new mutator thread needs a fresh
+    // trap page -- so, unlike the read side below, they're free to take a
+    // lock. Reusing the freelist's own mutex serializes concurrent
+    // registrations (two threads starting up at once), which sidesteps the
+    // usual lock-free-MPSC-queue publish-ordering problem entirely: only
+    // one writer is ever touching `count`/the array at a time.
+    //
+    // The reader (YieldPointTrap_isRegisteredPage, called from a signal
+    // handler) still can't take this lock -- it does a lock-free ACQUIRE
+    // load of the counter instead. The RELEASE store below is what makes
+    // that safe: it guarantees any thread whose acquire-load observes the
+    // bumped count also observes the plain pointer write just before it,
+    // per the C11 release/acquire synchronizes-with relation. Without the
+    // release ordering, a reader on a weakly-ordered architecture (ARM64)
+    // could observe the bumped count before the pointer write itself is
+    // visible -- reading a stale/zero slot, defeating the whole registry.
+    YieldPointTrap_initFreeList();
+    mutex_lock(&YieldPointTrap_freeListLock);
+    size_t idx = atomic_load_explicit(&YieldPointTrap_registryCount,
+                                      memory_order_relaxed);
+    if (idx < YIELD_POINT_TRAP_REGISTRY_CAPACITY) {
+        YieldPointTrap_registry[idx] = addr;
+    }
+    atomic_store_explicit(&YieldPointTrap_registryCount, idx + 1,
+                          memory_order_release);
+    mutex_unlock(&YieldPointTrap_freeListLock);
+    // idx >= capacity is silently dropped: see the capacity comment above
+    // for why that's not expected in practice. A dropped registration only
+    // means one more mutator's stale traps fall back to being treated as
+    // real faults (the pre-fix behavior for everyone), not a new risk.
+}
+
+// Signal-handler-safe: no locks, no allocation, just an acquire-load of a
+// monotonic counter plus a scan of already-published (write-then-release-
+// counter-bump, see YieldPointTrap_register) entries.
+bool YieldPointTrap_isRegisteredPage(const void *faultAddress) {
+    if (faultAddress == NULL)
+        return false;
+    uintptr_t pageSize = getPageSize();
+    uintptr_t faultPage = ((uintptr_t)faultAddress) / pageSize;
+    size_t count = atomic_load_explicit(&YieldPointTrap_registryCount,
+                                        memory_order_acquire);
+    if (count > YIELD_POINT_TRAP_REGISTRY_CAPACITY)
+        count = YIELD_POINT_TRAP_REGISTRY_CAPACITY;
+    for (size_t i = 0; i < count; i++) {
+        void *page = YieldPointTrap_registry[i];
+        if (page != NULL && ((uintptr_t)page) / pageSize == faultPage) {
+            return true;
+        }
+    }
+    return false;
+}
