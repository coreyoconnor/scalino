+/* ---- Debug-only live-heap object graph dump --------------------------
+ * Not part of upstream scala-native. Like the histogram above, but at
+ * per-object granularity: every live object (address, size, name) plus
+ * every outgoing pointer field that survives the same liveness checks
+ * used for marking, plus which objects are directly reachable from a
+ * root (stack/module/custom-root scan). This is enough to rebuild a
+ * dominator tree offline and compute *retained* size -- e.g. "object A
+ * retains array B" even though B is a separate allocation -- which a
+ * per-class histogram alone cannot express, and which correctly avoids
+ * double-counting an array/object reachable from more than one place.
+ *
+ * Streamed directly to $SCALANATIVE_HEAP_GRAPH_FILE as objects/edges are
+ * discovered (not buffered in memory first, unlike the histogram table)
+ * because the live set has no fixed upper bound. One block per mark
+ * cycle, delimited by "--- cycle=N ... ---" / "--- end cycle=N ... ---".
+ * Zero-cost when the env var is unset (checked once, cached).
+ *
+ * Attribution of edges relies on `Marker_Mark`'s own traversal order:
+ * `graphDumpCurrentParent` is NULL for the entire root-scanning phase
+ * (Marker_MarkRoots resets it before any scan runs) and is set to the
+ * object currently being processed for the duration of that object's own
+ * field loop inside `Marker_Mark`'s while-loop body.
+ */
+static int graphDumpEnabledChecked = 0;
+static const char *graphDumpFilePath = NULL; // raw env var value, as given
+static char *graphDumpResolvedPath = NULL;   // %p-substituted / pid-suffixed
+static FILE *graphDumpFile = NULL;
+static uint64_t graphDumpCycle = 0;
+static uint64_t graphDumpTotalObjects = 0;
+static uint64_t graphDumpTotalBytes = 0;
+static Object *graphDumpCurrentParent = NULL;
+
+// scalino's own toolchain is exactly the case this must handle: a single
+// `scalino build`/`run`/`package` invocation spawns scalino-dotc AND
+// scalino-linkdriver as SEPARATE processes, both scala-native binaries,
+// both inheriting the same $SCALANATIVE_HEAP_GRAPH_FILE -- with a literal
+// path, every one of them calls fopen(path, ...) on the exact same file,
+// racing truncations/writes from independent processes against each
+// other. Observed in practice: a dump loaded mid-corruption threw
+// "NotReadableError" in the browser. Same family of problem as multiple
+// processes writing one core dump or one JFR/heap-profile file, so this
+// takes the same fix the JVM (-XX:HeapDumpPath=...%p...) and the Linux
+// kernel (core_pattern's %p) use: substitute the process's own PID into
+// the filename. Unlike those, %p is not required here -- a plain
+// scala-native program not spawning any subprocesses would work fine
+// without one -- but scalino's own multi-process build is the common
+// case for anyone loading this file's own README example verbatim, so a
+// PID suffix is appended automatically even without an explicit %p,
+// making the safe behavior the default rather than something you have to
+// know to opt into.
+static void GraphDump_resolvePath(void) {
+    if (graphDumpResolvedPath != NULL || graphDumpFilePath == NULL)
+        return;
+    char pidBuf[32];
+    snprintf(pidBuf, sizeof(pidBuf), "%d", (int)getpid());
+    size_t rawLen = strlen(graphDumpFilePath);
+    size_t pidLen = strlen(pidBuf);
+    const char *placeholder = strstr(graphDumpFilePath, "%p");
+    char *buf;
+    if (placeholder != NULL) {
+        size_t prefixLen = (size_t)(placeholder - graphDumpFilePath);
+        size_t suffixLen = rawLen - prefixLen - 2; // "%p" is 2 chars
+        buf = (char *)malloc(prefixLen + pidLen + suffixLen + 1);
+        if (buf == NULL)
+            return;
+        memcpy(buf, graphDumpFilePath, prefixLen);
+        memcpy(buf + prefixLen, pidBuf, pidLen);
+        memcpy(buf + prefixLen + pidLen, placeholder + 2, suffixLen);
+        buf[prefixLen + pidLen + suffixLen] = '\0';
+    } else {
+        // Auto-append ".<pid>" right before the last '.' extension in the
+        // basename (after the last path separator), or at the very end if
+        // there's no extension: "heap.graph" -> "heap.<pid>.graph",
+        // "heap" -> "heap.<pid>".
+        const char *lastSlash = strrchr(graphDumpFilePath, '/');
+#ifdef _WIN32
+        const char *lastBackslash = strrchr(graphDumpFilePath, '\\');
+        if (lastBackslash != NULL &&
+            (lastSlash == NULL || lastBackslash > lastSlash))
+            lastSlash = lastBackslash;
+#endif
+        const char *basename =
+            lastSlash != NULL ? lastSlash + 1 : graphDumpFilePath;
+        const char *lastDot = strrchr(basename, '.');
+        size_t insertAt =
+            lastDot != NULL ? (size_t)(lastDot - graphDumpFilePath) : rawLen;
+        size_t tailLen = rawLen - insertAt;
+        buf = (char *)malloc(insertAt + 1 + pidLen + tailLen + 1);
+        if (buf == NULL)
+            return;
+        size_t pos = 0;
+        memcpy(buf + pos, graphDumpFilePath, insertAt);
+        pos += insertAt;
+        buf[pos++] = '.';
+        memcpy(buf + pos, pidBuf, pidLen);
+        pos += pidLen;
+        memcpy(buf + pos, graphDumpFilePath + insertAt, tailLen);
+        pos += tailLen;
+        buf[pos] = '\0';
+    }
+    graphDumpResolvedPath = buf;
+    // Always visible (not gated behind SCALANATIVE_GC_LOG_LEVEL, which
+    // defaults to WARN and would otherwise hide this): the whole point is
+    // so a user staring at several processes' worth of dumps -- scalino,
+    // scalino-dotc, scalino-linkdriver -- can tell which file is which
+    // without guessing PIDs themselves.
+    fprintf(stderr, "[scalino GC] heap graph dump: %s\n", graphDumpResolvedPath);
+}
+
+static inline int GraphDump_enabled(void) {
+    if (!graphDumpEnabledChecked) {
+        graphDumpFilePath = getenv("SCALANATIVE_HEAP_GRAPH_FILE");
+        graphDumpEnabledChecked = 1;
+    }
+    return graphDumpFilePath != NULL;
+}
+
+static int graphDumpAppendChecked = 0;
+static int graphDumpAppend = 0;
+
+static inline int GraphDump_appendMode(void) {
+    if (!graphDumpAppendChecked) {
+        // Default is "w": each cycle OVERWRITES the file with just that
+        // cycle's snapshot, not the histogram's append-forever behavior.
+        // A real program does many mark cycles (scalino-linkdriver's own
+        // build does dozens), and a full object+edge dump is much bigger
+        // per cycle than the histogram's fixed-size per-class table --
+        // appending every cycle produced multi-GB files in practice
+        // (16GB observed) that no browser can load. Most uses just want
+        // "the live heap right now" (the viewer already defaults to
+        // showing the last cycle in a file), so bounding the file to one
+        // cycle is the right default; set SCALANATIVE_HEAP_GRAPH_APPEND=1
+        // to opt back into a real time series across cycles.
+        graphDumpAppend = getenv("SCALANATIVE_HEAP_GRAPH_APPEND") != NULL;
+        graphDumpAppendChecked = 1;
+    }
+    return graphDumpAppend;
+}
+
+static void GraphDump_begin(void) {
+    graphDumpCurrentParent = NULL;
+    if (!GraphDump_enabled())
+        return;
+    GraphDump_resolvePath();
+    if (graphDumpResolvedPath == NULL)
+        return;
+    graphDumpFile =
+        fopen(graphDumpResolvedPath, GraphDump_appendMode() ? "a" : "w");
+    if (graphDumpFile == NULL)
+        return;
+    graphDumpTotalObjects = 0;
+    graphDumpTotalBytes = 0;
+    double wallSeconds = (double)Time_current_nanos() / 1e9;
+    fprintf(graphDumpFile, "--- cycle=%llu wall_seconds=%.3f ---\n",
+            (unsigned long long)graphDumpCycle, wallSeconds);
+}
+
+static void GraphDump_recordObject(Object *object) {
+    if (graphDumpFile == NULL)
+        return;
+    uint64_t size = (uint64_t)Object_Size(object);
+    graphDumpTotalObjects++;
+    graphDumpTotalBytes += size;
+    int isArray = Object_IsArray(object) ? 1 : 0;
+    char name[HISTOGRAM_NAME_MAX];
+    name[0] = 0;
+    wchar_t *wname = Object_nameWString(object);
+    if (wname != NULL) {
+        size_t i = 0;
+        for (; i < HISTOGRAM_NAME_MAX - 1 && wname[i] != 0; i++) {
+            wint_t c = (wint_t)wname[i];
+            name[i] = (c >= 32 && c < 127) ? (char)c : '?';
+        }
+        name[i] = 0;
+        free(wname);
+    }
+    fprintf(graphDumpFile, "O,%p,%llu,%d,%s\n", (void *)object,
+            (unsigned long long)size, isArray, name);
+}
+
+// Called from the single choke point (Marker_markObject) every time a
+// live object is discovered, whether newly marked or already marked --
+// duplicate edges are harmless (the offline dominator computation is
+// unaffected by repeated/multi-edges) and cheaper to allow than to filter
+// here.
+static inline void GraphDump_recordDiscovery(Object *object) {
+    if (graphDumpFile == NULL)
+        return;
+    if (graphDumpCurrentParent == NULL) {
+        fprintf(graphDumpFile, "R,%p\n", (void *)object);
+    } else {
+        fprintf(graphDumpFile, "E,%p,%p\n", (void *)graphDumpCurrentParent,
+                (void *)object);
+    }
+}
+
+// Conservative-scan counterpart of GraphDump's field-edge widening below:
+// `Object_GetUnmarkedObject` (Object.c) deliberately returns NULL once an
+// object is already marked (om_marked, not om_allocated -- see
+// ObjectMeta.h) because the real marker has nothing left to do with it.
+// That's correct for marking but wrong for the graph dump: a second
+// conservative root pointing at an already-marked object is still a real
+// edge (or a real second root) that must be recorded. This is a
+// deliberately trimmed copy of that function's address resolution with
+// the "already marked -> NULL" early-out removed; unlike the original it
+// does NOT fall back to `Object_getInnerPointer` for a mid-object
+// conservative hit (that helper is private to Object.c) -- an accepted
+// gap for a debug visualizer: a conservative pointer into the middle of
+// an object (not its header) is rare and simply won't be recorded here.
+static inline Object *GraphDump_resolveConservative(Heap *heap,
+                                                     word_t *word) {
+    BlockMeta *blockMeta =
+        Block_GetBlockMeta(heap->blockMetaStart, heap->heapStart, word);
+    word_t *aligned = BlockMeta_ContainsLargeObjects(blockMeta)
+                          ? (word_t *)((word_t)word & LARGE_BLOCK_MASK)
+                          : (word_t *)((word_t)word &
+                                       ALLOCATION_ALIGNMENT_INVERSE_MASK);
+    ObjectMeta *wordMeta = Bytemap_Get(heap->bytemap, aligned);
+    if (ObjectMeta_IsAllocated(wordMeta) || ObjectMeta_IsMarked(wordMeta))
+        return (Object *)aligned;
+    return NULL;
+}
+
+static void GraphDump_end(void) {
+    if (graphDumpFile == NULL)
+        return;
+    fprintf(graphDumpFile,
+            "--- end cycle=%llu total_objects=%llu total_bytes=%llu ---\n",
+            (unsigned long long)graphDumpCycle,
+            (unsigned long long)graphDumpTotalObjects,
+            (unsigned long long)graphDumpTotalBytes);
+    fclose(graphDumpFile);
+    graphDumpFile = NULL;
+    graphDumpCycle++;
+}
